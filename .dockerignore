# Secrets & runtime data — never copy into the image
data/
certs/
.env
.env.*
!.env.example

# Dependencies & build outputs (rebuilt inside the image)
**/node_modules/
**/dist/
**/build/
client/dist/
server/dist/
shared/dist/
# Stale incremental-build cache must NOT enter the image, or `tsc` skips emit.
**/*.tsbuildinfo

# Tests & CI artifacts
**/coverage/
playwright-report/
test-results/
**/*.test.ts
**/*.spec.ts
e2e/

# VCS / editor / OS
.git/
.gitignore
.idea/
.vscode/
**/.DS_Store
*.log
