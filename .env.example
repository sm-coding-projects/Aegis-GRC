# Aegis GRC — runtime configuration (copy to .env; never commit a real .env)

# Port the HTTPS server listens on inside the container.
PORT=8443

# Idle session timeout in minutes. After this much inactivity the DB handle is
# closed (data re-locked) and the session destroyed.
IDLE_TIMEOUT_MIN=30

# Where the single encrypted database file lives (mounted volume in Docker).
DATA_DIR=/data

# Where TLS material is read from. If certs/fullchain.pem + certs/privkey.pem
# are absent, a self-signed cert is generated on first start (dev only).
CERTS_DIR=/certs

# Max size (bytes) for a single uploaded evidence file stored inside the DB.
MAX_EVIDENCE_BYTES=10485760

# Node environment.
NODE_ENV=production
